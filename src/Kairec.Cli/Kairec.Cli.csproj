<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>kairec</AssemblyName>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <!-- NativeAOT cannot be cross-compiled for another OS: the Linux build is AOT, the Windows one a single self-contained exe. -->
  <PropertyGroup Condition="!$(RuntimeIdentifier.StartsWith('win'))">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <ApplicationIcon>../../packaging/brand/kairec.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kairec.Protocol/Kairec.Protocol.csproj" />
  </ItemGroup>
</Project>
