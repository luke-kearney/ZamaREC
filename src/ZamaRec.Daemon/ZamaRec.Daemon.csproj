<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ApplicationIcon>../../packaging/windows/zamarec.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- The Windows build: no console (it lives in the tray and logs to a file), one self-contained exe. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
    <AssemblyName>zamarec-daemon</AssemblyName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also built into the assembly, for the single-file exe (served when no wwwroot folder sits next to the daemon). -->
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ZamaRec.Core/ZamaRec.Core.csproj" />
    <ProjectReference Include="../ZamaRec.Protocol/ZamaRec.Protocol.csproj" />
  </ItemGroup>
</Project>
